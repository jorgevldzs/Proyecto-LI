# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave empty to use SQLite, or set a full URL for PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Set to False if SSL is terminated at a reverse proxy (e.g. Nginx, Railway, Render)
SECURE_SSL_REDIRECT=True

# Django log level (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=WARNING
